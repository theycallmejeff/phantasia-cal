# Copy to .env for local development. Find these in Supabase:
# Project URL: "Connect" button in the dashboard. Key: Project Settings → API Keys (publishable or legacy anon)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Google Places autocomplete for event locations (see README)
VITE_GOOGLE_MAPS_API_KEY=
